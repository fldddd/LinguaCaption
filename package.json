{
  "name": "linguacaption",
  "version": "1.0.0",
  "description": "LinguaCaption - English subtitle learning tool",
  "main": "electron/main.js",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "cd python-backend && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev": "concurrently --names frontend,backend --prefix-colors cyan,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "preview": "vite preview"
  },
  "keywords": ["language", "learning", "subtitle"],
  "author": "LinguaCaption Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "vite": "^6.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  }
}
